{
  "name": "call-recorder",
  "version": "1.0.0",
  "description": "Aida — multi-tenant call capture, transcription (Deepgram), AI analysis (Claude), and follow-up (Gmail/Calendar/CRM) on Twilio",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "smoke": "node --test \"smoke/**/*.test.js\"",
    "smoke:preflight": "node smoke/preflight.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "googleapis": "^140.0.0",
    "multer": "^1.4.5-lts.1",
    "twilio": "^4.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "optionalDependencies": {
    "retell-sdk": "5.53.0"
  }
}
