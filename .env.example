# Aida environment variables — copy to `.env` and fill in.
# Authoritative reference & notes: DEPLOYMENT.md. Never commit the real .env.
# Startup fails closed (config/startup-check.js) if a CRITICAL var is missing.

# ── CRITICAL (app refuses to start without these) ──────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=            # service-role key — server only, never shipped to the browser
SESSION_SECRET=                 # signs operator sessions + invite tokens
ENCRYPTION_KEY=                 # >= 32 chars — encrypts stored OAuth tokens (fail-closed)

# ── Operator dashboard ─────────────────────────────────────────────
OPERATOR_CLIENT_ID=default      # clients.slug this deployment's operator dashboard manages
DASHBOARD_PASSWORD=             # operator login password

# ── Telephony (Twilio) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=              # also validates X-Twilio-Signature on webhooks
TWILIO_PHONE_NUMBER=            # E.164, e.g. +61...
CLIENT_REAL_NUMBER=            # legacy single-tenant fallback (see ENGINEERING_BACKLOG.md P2-5)

# ── AI pipeline ────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ── Google (Gmail + Calendar OAuth, per client) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Runtime ────────────────────────────────────────────────────────
BASE_URL=                       # public https URL, for Twilio callbacks + OAuth redirect
PORT=3000
# NODE_ENV=development           # disables Twilio signature validation — NEVER in production
# VOICEMAIL_GREETING=            # optional TTS fallback greeting text

# ── Smoke-test runner (optional; see smoke/README.md) ──────────────
# SMOKE_BASE_URL=https://your-app.up.railway.app
# SMOKE_CLIENT_EMAIL=
# SMOKE_CLIENT_PASSWORD=
