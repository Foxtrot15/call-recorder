# Aida environment variables — copy to `.env` and fill in.
# Authoritative reference & notes: DEPLOYMENT.md. Never commit the real .env.
# Startup fails closed (config/startup-check.js) if a CRITICAL var is missing.

# ── CRITICAL (app refuses to start without these) ──────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=            # service-role key — server only, never shipped to the browser
SESSION_SECRET=                 # signs operator sessions + invite tokens
ENCRYPTION_KEY=                 # >= 32 chars — encrypts stored OAuth tokens (fail-closed)

# ── Operator dashboard ─────────────────────────────────────────────
OPERATOR_CLIENT_ID=default      # clients.slug this deployment's operator dashboard manages
DASHBOARD_PASSWORD=             # operator login password

# ── Telephony (Twilio) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=              # also validates X-Twilio-Signature on webhooks
TWILIO_PHONE_NUMBER=            # E.164, e.g. +61...
CLIENT_REAL_NUMBER=            # legacy single-tenant fallback (see ENGINEERING_BACKLOG.md P2-5)

# ── AI pipeline ────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ── Google (Gmail + Calendar OAuth, per client) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Runtime ────────────────────────────────────────────────────────
BASE_URL=                       # public https URL, for Twilio callbacks + OAuth redirect
PORT=3000
# NODE_ENV=development           # disables Twilio signature validation — NEVER in production
# VOICEMAIL_GREETING=            # optional TTS fallback greeting text

# ── VoIP v2 (Phase 0 scaffold — leave OFF in production) ───────────
# Strictly "true" enables; anything else is off. When enabled, the vars
# below become fail-closed at startup (docs/VOIP_V2_BACKEND_SPEC.md §4).
VOIP_V2_ENABLED=false
# TWILIO_API_KEY_SID=             # signs Twilio Access Tokens (not the account auth token)
# TWILIO_API_KEY_SECRET=
# TWILIO_APNS_PUSH_CREDENTIAL_SID=  # iOS VoIP pushes
# TWILIO_FCM_PUSH_CREDENTIAL_SID=   # Android pushes

# ── AIDA Locksmith Receptionist (public product page) ──────────────
# DORMANT BY DEFAULT: without LOCKSMITH_PILOT_ENABLED="true" the routes 404.
# The rest are optional — once enabled the page renders without any of them,
# showing visible "[TO BE CONFIRMED: …]" placeholders. See
# docs/LOCKSMITH_PILOT_SPEC.md.
# LOCKSMITH_PILOT_ENABLED=true      # only "true" serves the page (default: OFF — routes 404)
# LOCKSMITH_ENQUIRY_ENABLED=true    # only "true" enables submissions (default: OFF — no sink exists yet)
# LOCKSMITH_DEMO_PHONE=             # E.164; until set, no tel: link is rendered
# LOCKSMITH_CONTACT_EMAIL=          # footer contact
# NICHE_DROPS_ABN=
# NICHE_DROPS_PRIVACY_URL=
# NICHE_DROPS_TERMS_URL=
# LOCKSMITH_CONTACT_REGION=         # default "Melbourne, Victoria, Australia"
# LOCKSMITH_SETUP_PRICE=149
# LOCKSMITH_MONTHLY_PRICE=299
# LOCKSMITH_INCLUDED_DAYS=14
# LOCKSMITH_PILOT_LIMIT=3
# LOCKSMITH_PILOT_REGION=Melbourne

# ── Locksmith autonomous onboarding (M2 — dormant) ─────────────────
# Gated separately from the public page above. Also requires
# supabase/sql/lpm2_create_locksmith_onboarding.sql to be applied first.
# See docs/LOCKSMITH_ONBOARDING_SPEC.md.
# LOCKSMITH_ONBOARDING_ENABLED=true   # only "true" mounts the review + founder routes (default: OFF)

# ── Retell voice provider (M3 — dormant, spends money when enabled) ─
# FOUR independent danger gates, all strict ("true" only), all OFF by default,
# plus RETELL_DRY_RUN which is ON by default and only "false" turns it off.
# Nothing here is required; with none of it set the integration is inert.
# See docs/RETELL_INTEGRATION_SPEC.md.
# RETELL_ENABLED=true                 # the integration exists at all
# RETELL_WEBHOOK_ENABLED=true         # process inbound provider events
# RETELL_LIVE_WRITES_ENABLED=true     # may create/update resources at Retell
# RETELL_LIVE_CALLS_ENABLED=true      # MAY PLACE PHONE CALLS — this spends money
# RETELL_DRY_RUN=false                # leave dry-run (default is dry-run ON)
# RETELL_API_KEY=                     # also the webhook signing secret — never logged
# RETELL_API_BASE_URL=                # https origin only, no path (default https://api.retellai.com)
# RETELL_DEFAULT_VOICE_ID=            # from the Retell dashboard; no default is invented
# RETELL_DEFAULT_LANGUAGE=en-AU       # confirm against the supported locale list first
# RETELL_OUTBOUND_ONBOARDING_NUMBER=  # E.164; required before any call can be placed
# RETELL_INBOUND_DEMO_NUMBER=
# RETELL_WEBHOOK_BASE_URL=            # public https base for /webhooks/retell
# RETELL_ALLOWED_TAG=dev              # dev | staging | prod
# RETELL_TIMEOUT_MS=30000
# RETELL_MAX_RETRIES=2
# RETELL_WEBHOOK_MAX_BYTES=524288
# RETELL_RECORDING_ENABLED=true       # default OFF pending the founder's legal wording
# RETELL_TRANSCRIPT_RETENTION=keep_12_months

# ── Smoke-test runner (optional; see smoke/README.md) ──────────────
# SMOKE_BASE_URL=https://your-app.up.railway.app
# SMOKE_CLIENT_EMAIL=
# SMOKE_CLIENT_PASSWORD=
