# AIDA PLATFORM — DEV persistence harness (P36).
#
# Copy to .env.platform-dev and fill in. That filename is gitignored by the
# existing `.env.*` rule; this template is the only one that is tracked.
#
#   cp .env.platform-dev.example .env.platform-dev
#
# ── WHAT THIS IS FOR ────────────────────────────────────────────────
# The live DEV contract suite and the founder's browser pass. Nothing else
# reads it, and no sibling worktree's .env is touched.
#
# ── THE ONLY PROJECT THIS MAY NAME ──────────────────────────────────
# scripts/dev/platform-dev-supabase.js REFUSES to build a client for any
# project ref except wvwemitmmsdytyutaqbm, before the handle exists. That is a
# thrown error, not a warning — a persistence test that passes against
# production is worse than one that fails.

# DEV only. Any other ref is refused.
SUPABASE_URL=https://wvwemitmmsdytyutaqbm.supabase.co

# The approved DEV service-role key. Never printed by any tool here.
SUPABASE_SERVICE_KEY=

# ── running the live contract ───────────────────────────────────────
# The live suite SKIPS unless this is the exact string "true", so an ordinary
# `npm test` never touches a database and never needs a key.
#
#   PLATFORM_DEV_LIVE=true \
#   PLATFORM_DEV_ENV_FILE=.env.platform-dev \
#   node --test test/platform-dev-live.test.js
PLATFORM_DEV_LIVE=

# ── running the application against DEV ─────────────────────────────
# "memory" (the default) or "postgres". Requesting postgres and receiving
# memory is the failure store-binding.js exists to prevent: if ACP1 readiness
# cannot be proven, no store is returned at all.
PLATFORM_CONFIG_STORE=memory

# The configuration API and UI are both behind this exact string.
PLATFORM_CONFIG_API_ENABLED=

# The fictional client the P36 fixture uses. Never a real business.
PLATFORM_DEV_FIXTURE_SLUG=aida_platform_dev_contract
