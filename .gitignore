# Dependencies
node_modules/

# Environment / secrets — never commit real credentials.
# .env.example is intentionally tracked (see below).
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build / coverage output
dist/
build/
coverage/
*.tsbuildinfo

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Runtime / temp
tmp/
temp/
*.pid

# Orchestration scratch — transient requirements ledger, one per work batch,
# cleared at batch close (see .claude/skills/aida-orchestrate/). Never committed.
.agent/

# Claude Code personal/local settings (permissions etc.) — machine-specific.
# Shared skills under .claude/skills/ ARE tracked.
.claude/settings.local.json

# M8K DNCR proof handoff (process A -> process B). Regenerated each run.
scripts/dev/acquisition-dncr-proof/.process-a-saw.json

# E-5 batch approval proof: the file-backed store and the A -> B handoff.
# Both are regenerated by process-a.js on every run and are never evidence of
# anything on their own.
scripts/dev/acquisition-batch-approval-proof/.e5-store.json
scripts/dev/acquisition-batch-approval-proof/.process-a-approved.json

# M8L duplicate resolution proof. Same shape, same reason.
scripts/dev/acquisition-duplicate-proof/.m8l-store.json
scripts/dev/acquisition-duplicate-proof/.process-a-decided.json
