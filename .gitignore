# Dependencies
node_modules/

# Environment / secrets — never commit real credentials.
# .env.example is intentionally tracked (see below).
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build / coverage output
dist/
build/
coverage/
*.tsbuildinfo

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Runtime / temp
tmp/
temp/
*.pid

# Orchestration scratch — transient requirements ledger, one per work batch,
# cleared at batch close (see .claude/skills/aida-orchestrate/). Never committed.
.agent/

# Claude Code personal/local settings (permissions etc.) — machine-specific.
# Shared skills under .claude/skills/ ARE tracked.
.claude/settings.local.json
